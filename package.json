{
  "name": "simple-worktrunk",
  "version": "0.2.0",
  "description": "A TypeScript SDK wrapper for worktrunk 0.53+",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "worktrunk",
    "git",
    "worktree",
    "wrapper",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:unit": "vitest test/unit",
    "test:integration": "vitest test/integration",
    "test:run": "vitest run",
    "dev": "tsup --watch",
    "lint": "tsc",
    "demo": "node playground/demo.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "simple-git": "^3.30.0",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=18"
  }
}
